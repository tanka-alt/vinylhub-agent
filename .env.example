# Copy this file to .env for local development.
# In production (Render/Railway/Fly/etc.) set these as environment variables
# in the hosting dashboard instead of committing a .env file.

# Google AI Studio API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Model name — kept identical to the original n8n workflow.
# Verify this string is still valid at https://ai.google.dev/gemini-api/docs/models
# if you ever see a "model not found" error.
GEMINI_MODEL=gemini-3.1-flash-lite

# Supabase project — use a FRESH key you generate yourself, not a reused one.
# Find it in the dashboard under Settings -> API Keys.
# Use the SECRET key (starts with sb_secret_..., or the legacy service_role
# key if that's what your project still shows under an "API Keys (Legacy)"
# tab) — this is server-side only, never expose it to a browser. Do NOT use
# the publishable/anon key here; it won't have enough access to read data
# if the "albumid" table has Row Level Security enabled.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=

# Comma-separated list of origins allowed to call this API.
# Use "*" only while testing; lock it to your real site before going live.
ALLOWED_ORIGINS=https://vinylhub-ten.vercel.app

# How many past messages (user+assistant combined) to keep per session.
# n8n's memoryBufferWindow node defaults to a window of 5 exchanges (~10 messages).
MEMORY_WINDOW=10

PORT=3000
